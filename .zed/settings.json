{
  // This crate is deliberately hand-formatted; format-on-save would rewrite nearly every file.
  "languages": {
    "Rust": {
      "format_on_save": "off"
    }
  },
  "lsp": {
    "rust-analyzer": {
      // CI gates on clippy -D warnings, so surface those diagnostics live instead of `cargo check`'s.
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/target",
    "**/.worktrees",
    "**/.testenv",
    "**/vault-refs",
    "**/specs",
    "**/node_modules"
  ]
}
